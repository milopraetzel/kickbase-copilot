# ============================================================================
# Kickbase KI-Cockpit & Agent — Konfiguration (.env)
# Kopieren nach: cp api/.env.example api/.env
# ============================================================================

# --- 1. Kickbase-Zugang (Weg A via Token ODER Weg B via E-Mail/Passwort) ----
# Weg A: Token aus dem Web-Login (play.kickbase.com) — nötig bei Apple/Google-Login
KICKBASE_TOKEN=
KICKBASE_REFRESH_TOKEN=

# Weg B: Klassischer Kickbase-Login per E-Mail & Passwort
KICKBASE_EMAIL=
KICKBASE_PASSWORD=

# Optional: Feste Liga-ID (wenn leer, wird die erste gefundene Liga genutzt)
KICKBASE_LEAGUE_ID=

# --- 2. Schutzliste (Unverkäufliche Spieler) --------------------------------
# Kommagetrennte Kickbase-Spieler-IDs, die der Agent NIEMALS verkaufen darf
# (auch nicht bei Tausch-Ketten oder Freitagabend-Notbremse). Leer = kein Schutz.
PROTECTED_PLAYER_IDS=

# --- 3. Autonomie-Stufen & Sicherheits-Schalter -----------------------------
# Stufe 1 (Standard / Co-Pilot): Agent rechnet alles durch und baut das Cockpit,
# führt aber noch keine echten Schreibaktionen bei Kickbase aus:
AGENT_DRY_RUN=1
AGENT_ALLOW_LIVE=0

# Stufe 2 (Autopilot mit Veto-Fenster): Auf 0 / 1 / 1 stellen, damit geplante
# Vorhaben nach Ablauf des Veto-Fensters und die Aufstellung live umgesetzt werden:
AGENT_AUTO_INTENTS=0
AGENT_AUTO_LINEUP=0
AGENT_AUTO_BONUS=0

# Stufe 3 (Unter-der-Woche Marktwert-Trading): Kauft & verkauft automatisch
# Marktwert-Steiger unter der Woche bis Freitag 14:30 Uhr:
AGENT_TRADE_AUTOPILOT=0

# --- 4. Optional: KI-News-Richter ("Jev" via TypeSafe) & Discord ------------
# Ohne Key läuft die Engine automatisch rein auf Kickbase- & LigaInsider-Signalen.
TYPESAFE_API_KEY=

# Optional: Schreib-Token für öffentliche Server-Installationen (lokal leer lassen)
KBA_API_WRITE_TOKEN=

# Optionale Discord-Benachrichtigungen (Tageszusammenfassung 08:15 Uhr)
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_USER_ID=

# --- 5. System-Defaults (normalerweise unverändert lassen) ------------------
DATABASE_URL=sqlite:///kba_local.db
KICKBASE_BASE_URL=https://api.kickbase.com
KICKBASE_RATE_LIMIT_PER_SECOND=1.0
OPENLIGA_BASE_URL=https://api.openligadb.de
KICKER_RSS_URL=https://newsfeed.kicker.de/news/bundesliga
LIGAINSIDER_ENABLED=true
AGENT_WRITE_SPACING_SECONDS=2.0
LOG_LEVEL=INFO
